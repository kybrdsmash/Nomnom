# Copy this file to .env and fill in real values. .env is gitignored.
EXPO_PUBLIC_GOOGLE_API_KEY=your_key_here

# OpenAI (voice-to-text for the "At the Table" journal note - see
# src/api/transcribe.js). Optional: the mic button just fails quietly and
# says "try typing instead" if this is missing. SECURITY: this is bundled
# into the client like the key above, but unlike Google's key, OpenAI has no
# per-app restriction option - a leaked key has no spending cap tied to it.
# Fine for now (see transcribe.js's own note on this), worth revisiting
# before a wider release.
EXPO_PUBLIC_OPENAI_API_KEY=your_key_here

# Firebase (from console.firebase.google.com > Project settings > Your apps > Web app)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Google Sign-In (Firebase Console > Authentication > Sign-in method > Google > Web client ID)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# Android-specific OAuth client (Google Cloud Console > Credentials > OAuth
# client ID > Android, package com.peach.nomnomapp + the release SHA-1)
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
