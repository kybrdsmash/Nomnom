{
  "cli": {
    "version": ">= 12.0.0",
    // "remote" (not "local") because app.config.js is a dynamic (.js) config -
    // EAS can't write an incremented version number back into a JS file the
    // way it can a static app.json, so it needs to track versionCode on its
    // own servers instead. Required for "production"'s autoIncrement below
    // to work at all.
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      }
    },
    // Identical to "production" - exists only because "production" kept
    // shipping a stale, already-fixed-in-source expo-asset native
    // dependency (NoClassDefFoundError: AnyTypeCache crash) even with
    // `eas build --clear-cache`, while a from-scratch local `npm ci` off
    // the exact same committed lockfile proved the dependency resolution
    // itself was correct. Strong sign some cache tied to the "production"
    // profile name specifically (likely Gradle-level, not npm) survived
    // clear-cache. A brand-new profile name has no build history to reuse
    // from at all. Use this until the root cause is confirmed and
    // "production" can be trusted again.
    "productionFresh": {
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        // Local, gitignored path to the Google Cloud service-account key
        // (Play Console > Users and permissions grants this account release
        // access - see TODO.md/README for setup notes). Not committed since
        // it's a credential.
        "serviceAccountKeyPath": "C:/Users/Isaac/keys/nomnom-play-submit.json",
        "track": "internal"
      }
    },
    // Same key, targets Play's Closed testing track instead ("alpha" is
    // Play's API name for it) - eas submit has no CLI flag to override
    // track per-run, so this is its own profile: `eas submit --profile
    // closedTesting`. Needed until the app clears Google's closed-testing
    // requirement (12+ testers opted in, running 14+ days) and Production
    // unlocks.
    "closedTesting": {
      "android": {
        "serviceAccountKeyPath": "C:/Users/Isaac/keys/nomnom-play-submit.json",
        "track": "alpha"
      }
    }
  }
}
