rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /sessions/{code} {
      allow read, write: if request.auth != null;
    }
    match /users/{uid}/pings/{pingId} {
      allow read, write: if request.auth != null;
    }
    match /journals/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || request.auth.uid in resource.data.friendUids);
      allow write: if request.auth != null && request.auth.uid == uid;
    }
    // Journal schema 2: one document per entry (see src/api/journal.js).
    // Same audience as the parent doc: the owner, plus anyone in the
    // owner's friendUids list.
    match /journals/{uid}/entries/{entryId} {
      allow read: if request.auth != null && (
        request.auth.uid == uid ||
        request.auth.uid in get(/databases/$(database)/documents/journals/$(uid)).data.friendUids
      );
      allow write: if request.auth != null && request.auth.uid == uid;
    }
    match /savedLists/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /bugReports/{reportId} {
      allow create: if request.auth != null;
      allow read, update, delete: if false;
    }
    match /cuisineFeedback/{feedbackId} {
      allow create: if request.auth != null;
      allow read, update, delete: if false;
    }
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
