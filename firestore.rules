rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /sessions/{code} {
      allow read, write: if request.auth != null;
    }
    match /users/{uid}/pings/{pingId} {
      allow read, write: if request.auth != null;
    }
    match /journals/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || request.auth.uid in resource.data.friendUids);
      allow write: if request.auth != null && request.auth.uid == uid;
    }
    // Journal schema 2: one document per entry (see src/api/journal.js).
    // Same audience as the parent doc: the owner, plus anyone in the
    // owner's friendUids list.
    match /journals/{uid}/entries/{entryId} {
      allow read: if request.auth != null && (
        request.auth.uid == uid ||
        request.auth.uid in get(/databases/$(database)/documents/journals/$(uid)).data.friendUids
      );
      allow write: if request.auth != null && request.auth.uid == uid;
    }
    match /savedLists/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /bugReports/{reportId} {
      allow create: if request.auth != null;
      allow read, update, delete: if false;
    }
    match /cuisineFeedback/{feedbackId} {
      allow create: if request.auth != null;
      allow read, update, delete: if false;
    }
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // Friend-code reverse lookup (src/api/friendCode.js): anyone signed in can
    // resolve a code to {uid, name}; only the owner can create or change theirs.
    match /friendCodes/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'name']);
      allow update: if request.auth != null
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'name']);
      allow delete: if false;
    }
    // Shared feed photo pool (src/api/feedPhotos.js): any signed-in device
    // upserts the spots it searched; fields are fixed to what the writer sends.
    match /feedPhotos/{placeId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.resource.data.keys().hasOnly(['placeId', 'name', 'photoUrl', 'cuisine', 'rating', 'updatedAt']);
      allow delete: if false;
    }
  }
}
